doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Crear Contraseña
    link(rel="stylesheet" href="/css/output.css")

  body.bg-gray-100

    .max-w-xl.mx-auto.p-6

      // HEADER
      header.bg-white.shadow.p-4.flex.justify-between.items-center.mb-6
        img(src="/img/logo.png" class="w-16")
        h1.text-xl.font-bold Carniceria "Mi Mary"
        a.text-blue-500(href="/login") Iniciar Sesión

      // FORMULARIO
      .bg-white.p-6.rounded.shadow
        form(onsubmit="return guardarDatos()")

          h2.text-xl.font-bold.mb-4 Completa tu registro

          // VALIDACIONES VISUALES
          .space-y-2.mb-4
            label.flex.items-center.gap-2
              input#Check1(type="checkbox" disabled)
              span.text-sm Mínimo 8 caracteres

            label.flex.items-center.gap-2
              input#Check2(type="checkbox" disabled)
              span.text-sm Una mayúscula

            label.flex.items-center.gap-2
              input#Check3(type="checkbox" disabled)
              span.text-sm Un número

            label.flex.items-center.gap-2
              input#Check4(type="checkbox" disabled)
              span.text-sm Un símbolo (!@#$%&)

          // PASSWORD
          input#password1.w-full.border.rounded.p-2.mb-3(
            type="password",
            placeholder="Crear contraseña",
            oninput="validar()",
            required
          )

          input#password2.w-full.border.rounded.p-2.mb-3(
            type="password",
            placeholder="Confirmar contraseña",
            oninput="validar()",
            required
          )

          // TELEFONO
          input#telefono.w-full.border.rounded.p-2.mb-3(
            type="text",
            placeholder="Teléfono",
            required
          )

          // DIRECCIÓN
          input#direccion.w-full.border.rounded.p-2.mb-3(
            type="text",
            placeholder="Dirección",
            required
          )

          button.bg-green-500.text-white.p-2.rounded.w-full(type="submit") Guardar

          p#mensaje.mt-3.text-center

    script.
      const params = new URLSearchParams(window.location.search)
      const correo = params.get('correo')

      function validar() {

        const pass = document.getElementById("password1").value;
        const pass2 = document.getElementById("password2").value;

        document.getElementById("Check1").checked = pass.length >= 8;
        document.getElementById("Check2").checked = /[A-Z]/.test(pass);
        document.getElementById("Check3").checked = /[0-9]/.test(pass);
        document.getElementById("Check4").checked = /[^A-Za-z0-9]/.test(pass);

        const coinciden = pass === pass2;

        const mensaje = document.getElementById("mensaje");

        mensaje.textContent =
          (pass2.length > 0 && !coinciden) ? "Las contraseñas no coinciden" :
          (coinciden && pass.length > 0) ? "Contraseñas correctas" : "";

        mensaje.className = coinciden ? "text-green-500 mt-3 text-center" : "text-red-500 mt-3 text-center";
      }

      function guardarDatos() {

        const password = document.getElementById("password1").value;
        const password2 = document.getElementById("password2").value;
        const telefono = document.getElementById("telefono").value.trim();
        const direccion = document.getElementById("direccion").value.trim();

        const params = new URLSearchParams(window.location.search);
        const correo = params.get('correo');

        if (password !== password2) {
          alert("Las contraseñas no coinciden");
          return false;
        }

        if (!/^[0-9]+$/.test(telefono)) {
          alert("El teléfono solo debe contener números");
          return false;
        }

        if (!correo || !telefono || !direccion) {
          alert("Faltan datos, verifica el formulario");
          return false;
        }

        fetch('/api/crear-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            correo: correo,
            password: password,
            telefono: telefono,
            direccion: direccion
          })
        })
        .then(res => res.json())
        .then(data => {

          if (data.error) {
            alert(data.error);
          } else {
            alert(data.mensaje);
            window.location.href = '/login';
          }
        })
        .catch(err => {
          console.error(err);
          alert("Error al guardar datos");
        });

        return false;
      }