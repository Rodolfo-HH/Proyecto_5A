doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Inicio | Carnicería "Mi Mary"
    script(src="https://cdn.tailwindcss.com")

  body(class="bg-[#F5E6CC] font-sans")

    //- Contenedor principal
    div(class="max-w-[1400px] mx-auto")

      //- HEADER
      header(class="bg-gradient-to-b from-[#8B0000] to-[#FF0000] rounded-t-xl flex items-center justify-between px-10 py-4 shadow-md")
        img#logo(src="/Imagenes/logo.png" alt="Logo" class="w-20 h-20 rounded-full object-cover")

        //- Buscador
        form(class="flex items-center bg-white rounded-full px-4 py-2 shadow-md gap-2")
          input(
            type="text"
            placeholder="Buscar..."
            class="border-none outline-none px-2 py-1 rounded-full w-72 text-sm text-gray-700"
          )
          button(
            type="submit"
            class="text-gray-400 hover:text-blue-500 transition text-lg cursor-pointer bg-transparent border-none"
          ) 🔍

        //- Botón hamburguesa
        button(
          onclick="openNav()"
          class="text-white text-3xl cursor-pointer ml-5 bg-transparent border-none"
        ) ☰

      hr(class="border-white")

      //- MENÚ OVERLAY LATERAL DERECHO
      #myNav(class="fixed top-[120px] right-[5px] w-[200px] bg-red-600 overflow-hidden transition-all duration-500 rounded-b-xl z-10" style="height:0")
        div(class="flex flex-col mt-12 px-2")
          a(href="/productos" class="text-[#F5E6CC] hover:text-white text-lg py-2 px-2 border-b border-red-400 flex items-center gap-2")
            img(src="/Imagenes/Iconos/Product.ico" class="w-6 h-6")
            | Productos
          a(href="/ofertas" class="text-[#F5E6CC] hover:text-white text-lg py-2 px-2 border-b border-red-400 flex items-center gap-2")
            img(src="/Imagenes/Iconos/Oferta.ico" class="w-6 h-6")
            | Ofertas
          a(href="/contacto" class="text-[#F5E6CC] hover:text-white text-lg py-2 px-2 border-b border-red-400 flex items-center gap-2")
            img(src="/Imagenes/Iconos/Contact.ico" class="w-6 h-6")
            | Contacto
          a#linkCerrarSesion(href="/" class="text-[#F5E6CC] hover:text-white text-lg py-2 px-2 flex items-center gap-2")
            img(src="/Imagenes/Iconos/Exit.ico" class="w-6 h-6")
            | Cerrar Sesión
        //- Botón cerrar
        a(href="javascript:void(0)" onclick="closeNav()" class="absolute top-1 right-6 text-white text-5xl cursor-pointer leading-none") &times;

      //- BANNERS
      div(class="flex flex-col md:flex-row gap-4 px-6 mt-5")
        div(class="bg-[#8B0000] rounded-xl p-1 flex-1 shadow-md")
          img#banner1(src="/Imagenes/banner1.png" alt="Banner 1" class="w-full h-[195px] object-cover rounded-lg")
        div(class="flex flex-col gap-1 flex-1")
          div(class="flex gap-1")
            img#banner2(src="/Imagenes/banner2.jpeg" alt="Banner 2" class="w-1/2 h-[195px] object-cover rounded-lg shadow")
            img(src="/Imagenes/banner3.jpeg" alt="Banner 3" class="w-1/2 h-[195px] object-cover rounded-lg shadow")
          //- Texto oferta
          div(class="bg-white rounded-xl text-center py-4 px-4 shadow mt-1")
            p(class="text-gray-700 text-base leading-relaxed mt-2")
              | "Aprovecha nuestras ofertas del día:"
              br
              | Carne fresca, precios accesibles y cortes al gusto.
              br
              strong ¡¡¡No pierdas la oportunidad de llevar calidad a tu mesa sin gastar de más!!!

      //- SECCIÓN IMAGEN LATERAL (equivale a Seccion5 / Seccion6)
      div(class="flex justify-end px-6 mt-4")
        div(class="bg-[#8B0000] rounded-xl p-1 shadow-md w-[450px]")
          div(class="bg-white rounded-lg p-3 w-full")
            img(src="/Imagenes/imagen_lateral.jpg" alt="Imagen lateral" class="w-full h-[220px] object-cover rounded")

      //- BOTONES
      div(class="flex justify-center gap-6 mt-8 mb-6")
        button(
          type="button"
          onclick="siguiente1()"
          class="bg-[#C0392B] hover:bg-red-800 text-white font-bold py-2 px-8 rounded-xl transition border-none cursor-pointer"
        ) Ver Catálogo
        button(
          type="button"
          onclick="siguiente2()"
          class="bg-gray-800 hover:bg-gray-900 text-white font-bold py-2 px-8 rounded-xl transition border-none cursor-pointer"
        ) Hacer Pedido

      //- FOOTER
      footer(class="bg-gradient-to-b from-[#FF0000] to-[#8B0000] text-white flex justify-around items-center px-10 py-4 rounded-b-xl mt-6")
        p(class="text-sm") 📞 Teléfono: #[span(class="font-bold") 764 764 3868]
        p(class="text-sm") 💬 WhatsApp: #[span(class="font-bold") 764 117 85 68]
        p(class="text-sm") 📘 Facebook: #[span(class="font-bold") Carnicería "Mi Mary"]

    script.
      function openNav() {
        document.getElementById("myNav").style.height = "260px";
      }
      function closeNav() {
        document.getElementById("myNav").style.height = "0";
      }

      const usuario = JSON.parse(localStorage.getItem('usuario'));
      const linkCerrar = document.getElementById('linkCerrarSesion');

      if (usuario) {
        linkCerrar.innerHTML = `
          <img src="/Imagenes/Iconos/Exit.ico" class="w-6 h-6">
          ${usuario.nombre} (Salir)
        `;
      }

      linkCerrar.addEventListener('click', function () {
        localStorage.removeItem('usuario');
      });

      function siguiente1() {
        window.location.href = "/productos";
      }
      function siguiente2() {
        if (!usuario) {
          alert('Debes iniciar sesión para hacer un pedido');
          window.location.href = "/login";
          return;
        }
        window.location.href = "/pedidos";
      }